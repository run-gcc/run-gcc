#!/usr/bin/env bash
# Compile and run C/C++ programs

set -euo pipefail

# Default configuration values
# General configuration
show_diff="false"
cleanup_output="true"
color_output="true"
execution_timeout=""
skip_config="false"

# Compiler configuration
compiler_flags="-Wall -Wextra"
c_flags="-std=c11"
cpp_flags="-std=c++17"
linker_flags="-lm"
default_c_compiler="gcc"
default_cpp_compiler="g++"

# Input/output configuration
default_input_file=""
default_expected_file=""

# Performance measurement configuration
measure_performance="false"
time_limit=""
memory_limit=""
show_performance="true"

# Template configuration
template_dir="$HOME/.run-gcc/templates"
default_template="default"

# Function to load configuration files
load_config() {
  local global_config="$HOME/.run-gccrc"
  local local_config="./.run-gccrc"

  # Source global configuration if it exists
  if [[ -f "$global_config" ]]; then
    # shellcheck source=/dev/null
    source "$global_config"
  fi

  # Source local configuration if it exists
  if [[ -f "$local_config" ]]; then
    # shellcheck source=/dev/null
    source "$local_config"
  fi
}

# Function to display an error message and exit
error_exit() {
  if [[ "$color_output" == "true" ]]; then
    echo -e "\e[31m\e[1mError:\e[0m $1" >&2
  else
    echo "Error: $1" >&2
  fi
  exit 1
}

# Function to initialize template directory
init_template_dir() {
  local template_base_dir="$HOME/.run-gcc"
  local user_template_dir="$template_base_dir/templates"
  
  # Create directory structure if it doesn't exist
  if [[ ! -d "$user_template_dir" ]]; then
    mkdir -p "$user_template_dir/c" "$user_template_dir/cpp"
    
    # Detect installation directory
    local script_dir
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local pkg_templates=""
    
    # Check various possible locations for pkg/templates
    if [[ -d "$script_dir/../pkg/templates" ]]; then
      pkg_templates="$script_dir/../pkg/templates"
    elif [[ -d "/usr/share/run-gcc/templates" ]]; then
      pkg_templates="/usr/share/run-gcc/templates"
    elif [[ -d "/usr/local/share/run-gcc/templates" ]]; then
      pkg_templates="/usr/local/share/run-gcc/templates"
    fi
    
    # Copy default templates from installation if available
    if [[ -n "$pkg_templates" && -d "$pkg_templates" ]]; then
      cp -r "$pkg_templates"/* "$user_template_dir/" 2>/dev/null || true
    else
      # Create basic default templates if no installation templates found
      cat > "$user_template_dir/c/default.c" << 'EOFT'
#include <stdio.h>

int main() {
    // Your code here
    
    return 0;
}
EOFT
      
      cat > "$user_template_dir/cpp/default.cpp" << 'EOFT'
#include <iostream>

using namespace std;

int main() {
    // Your code here
    
    return 0;
}
EOFT
    fi
  fi
}

# Function to list available templates for a given extension
list_templates() {
  local extension="$1"
  local lang_dir=""
  
  case "$extension" in
    c) lang_dir="c" ;;
    cpp|cc|cxx) lang_dir="cpp" ;;
    *) error_exit "Unsupported file extension '$extension'" ;;
  esac
  
  local template_path="$template_dir/$lang_dir"
  
  if [[ ! -d "$template_path" ]]; then
    error_exit "Template directory not found: $template_path"
  fi
  
  local templates=()
  while IFS= read -r -d '' file; do
    local basename="${file##*/}"
    local name="${basename%.*}"
    # Avoid duplicates by checking if name is already in array
    if [[ ${#templates[@]} -eq 0 || ! " ${templates[*]} " =~ " ${name} " ]]; then
      templates+=("$name")
    fi
  done < <(find "$template_path" -maxdepth 1 -type f \( -name "*.c" -o -name "*.cpp" -o -name "*.cc" -o -name "*.cxx" \) -print0 2>/dev/null)
  
  if [[ ${#templates[@]} -eq 0 ]]; then
    if [[ "$color_output" == "true" ]]; then
      echo -e "\e[33m\e[1mWarning:\e[0m No templates found for $extension files"
    else
      echo "Warning: No templates found for $extension files"
    fi
    return 1
  fi
  
  if [[ "$color_output" == "true" ]]; then
    echo -e "\e[1mAvailable templates for .$extension files:\e[0m"
  else
    echo "Available templates for .$extension files:"
  fi
  
  local i=1
  for template in "${templates[@]}"; do
    echo "  $i) $template"
    ((i++))
  done
  
  echo
}

# Function to create a new file from template
create_from_template() {
  local filename="$1"
  local template_name="${2:-$default_template}"
  
  # Extract extension
  local extension="${filename##*.}"
  
  # Determine language directory and possible template extensions
  local lang_dir=""
  local template_extensions=()
  case "$extension" in
    c) 
      lang_dir="c"
      template_extensions=("c")
      ;;
    cpp|cc|cxx) 
      lang_dir="cpp"
      template_extensions=("cpp" "cc" "cxx")
      ;;
    *) error_exit "Unsupported file extension '$extension'" ;;
  esac
  
  # Check if file already exists
  if [[ -f "$filename" ]]; then
    error_exit "File '$filename' already exists"
  fi
  
  # Try to find template with matching extension first, then fallback to common extensions
  local template_path=""
  local found_template="false"
  
  # First, try exact extension match
  if [[ -f "$template_dir/$lang_dir/$template_name.$extension" ]]; then
    template_path="$template_dir/$lang_dir/$template_name.$extension"
    found_template="true"
  else
    # Try other common extensions for this language
    for ext in "${template_extensions[@]}"; do
      if [[ -f "$template_dir/$lang_dir/$template_name.$ext" ]]; then
        template_path="$template_dir/$lang_dir/$template_name.$ext"
        found_template="true"
        break
      fi
    done
  fi
  
  if [[ "$found_template" != "true" ]]; then
    if [[ "$color_output" == "true" ]]; then
      echo -e "\e[33m\e[1mWarning:\e[0m Template '$template_name' not found"
    else
      echo "Warning: Template '$template_name' not found"
    fi
    echo
    list_templates "$extension"
    exit 1
  fi
  
  # Copy template to new file
  cp "$template_path" "$filename"
  
  if [[ "$color_output" == "true" ]]; then
    echo -e "\e[32m\e[1mSuccess:\e[0m Created '$filename' from template '$template_name'"
  else
    echo "Success: Created '$filename' from template '$template_name'"
  fi
}

# Function to display help message
show_help() {
  echo "Usage: $(basename "$0") <source_file> [OPTIONS]"
  echo "       $(basename "$0") --new <filename> [--template <name>]"
  echo "       $(basename "$0") --list-templates <extension>"
  echo "       $(basename "$0") --generate-config [--global|-g|--local]"
  echo
  echo "Options:"
  echo "  -h, --help            Show this help message"
  echo "  -v, --version         Show script version"
  echo "  -i, --input           Specify input file"
  echo "  -e, --expected        Specify expected output file for comparison"
  echo "  -d, --diff            Show difference between actual and expected output"
  echo "  -n, --no-config       Skip loading configuration files"
  echo "  -p, --performance     Measure and display runtime and memory usage"
  echo "  -t, --time-limit      Set time limit in seconds (for TLE checking)"
  echo "  -m, --memory-limit    Set memory limit in MB (for MLE checking)"
  echo "      --no-performance  Disable performance measurement display"
  echo "      --generate-config Generate a configuration file (.run-gccrc)"
  echo "  -g, --global          Generate global config file (in \$HOME)"
  echo "      --local           Generate local config file (default, in current directory)"
  echo
  echo "Template Options:"
  echo "      --new <filename>        Create a new file from template"
  echo "      --template <name>       Specify template name (default: $default_template)"
  echo "      --list-templates <ext>  List available templates for extension (c, cpp)"
  echo
  echo "Description:"
  echo "  A versatile Bash script to compile and run C/C++ programs with"
  echo "  input/output handling, output comparison, and more."
}

# Function to display version
show_version() {
  echo "$(basename "$0") version 1.3.0"
}

# Function to generate configuration file
generate_config() {
  local config_type="$1"  # "global" or "local"
  local config_file=""
  
  case "$config_type" in
    global)
      config_file="$HOME/.run-gccrc"
      ;;
    local)
      config_file="./.run-gccrc"
      ;;
    *)
      error_exit "Invalid config type '$config_type'. Use 'global' or 'local'."
      ;;
  esac
  
  # Check if file already exists
  if [[ -f "$config_file" ]]; then
    if [[ "$color_output" == "true" ]]; then
      echo -e "\e[33m\e[1mWarning:\e[0m Configuration file '$config_file' already exists."
    else
      echo "Warning: Configuration file '$config_file' already exists."
    fi
    read -p "Do you want to overwrite it? [y/N]: " -r
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
      echo "Configuration generation cancelled."
      exit 0
    fi
  fi
  
  # Generate the configuration file
  cat > "$config_file" << 'EOF'
#!/usr/bin/env bash
# run-gcc configuration file
# This file is sourced by run-gcc to set default values

# General configuration
show_diff="false"
cleanup_output="true"
color_output="true"
execution_timeout=""

# Compiler configuration
compiler_flags="-Wall -Wextra"
c_flags="-std=c11"
cpp_flags="-std=c++17"
linker_flags="-lm"
default_c_compiler="gcc"
default_cpp_compiler="g++"

# Input/output configuration
default_input_file=""
default_expected_file=""

# Performance measurement configuration
measure_performance="false"
time_limit=""
memory_limit=""
show_performance="true"

# Template configuration
template_dir="$HOME/.run-gcc/templates"
default_template="default"
EOF
  
  if [[ "$color_output" == "true" ]]; then
    echo -e "\e[32m\e[1mSuccess:\e[0m Configuration file created at '$config_file'"
  else
    echo "Success: Configuration file created at '$config_file'"
  fi
  echo "You can now edit this file to customize your default settings."
}

# Function to determine the compiler based on file extension
get_compiler() {
  local extension="${1##*.}"
  case "$extension" in
  c) echo "$default_c_compiler" ;;
  cpp | cc | cxx) echo "$default_cpp_compiler" ;;
  *) error_exit "Unsupported file type '$extension'" ;;
  esac
}

# Function to format time in a human-readable way
format_time() {
  local time_ms="$1"
  local time_s time_formatted
  
  if (( $(echo "$time_ms >= 1000" | bc -l) )); then
    time_s=$(echo "scale=3; $time_ms / 1000" | bc -l)
    printf "%.3fs" "$time_s"
  else
    printf "%.0fms" "$time_ms"
  fi
}

# Function to format memory in a human-readable way
format_memory() {
  local memory_kb="$1"
  local memory_mb memory_formatted
  
  if (( $(echo "$memory_kb >= 1024" | bc -l) )); then
    memory_mb=$(echo "scale=2; $memory_kb / 1024" | bc -l)
    printf "%.2f MB" "$memory_mb"
  else
    printf "%.0f KB" "$memory_kb"
  fi
}

# Function to display performance results with fancy formatting
display_performance() {
  local runtime_ms="$1"
  local memory_kb="$2"
  local time_limit="$3"
  local memory_limit="$4"
  local tle_status="$5"
  local mle_status="$6"
  
  if [[ "$show_performance" != "true" ]]; then
    return 0
  fi
  
  local formatted_time formatted_memory
  formatted_time=$(format_time "$runtime_ms")
  formatted_memory=$(format_memory "$memory_kb")
  
  if [[ "$color_output" == "true" ]]; then
    echo
    echo -e "\e[1m┌─ Performance Metrics ─────────────────────┐\e[0m"
    
    # Runtime display
    local time_color="\e[32m"  # Green by default
    local time_status=""
    if [[ "$tle_status" == "true" ]]; then
      time_color="\e[31m"  # Red for TLE
      time_status=" \e[31m\e[1m(TLE)\e[0m"
    elif [[ -n "$time_limit" ]]; then
      local time_percentage
      time_percentage=$(echo "scale=1; ($runtime_ms / 1000) / $time_limit * 100" | bc -l)
      if (( $(echo "$time_percentage >= 80" | bc -l) )); then
        time_color="\e[33m"  # Yellow for warning
      fi
      time_status=" \e[90m(${time_percentage}% of ${time_limit}s)\e[0m"
    fi
    
    echo -e "\e[1m│\e[0m \e[1mRuntime:\e[0m   ${time_color}\e[1m${formatted_time}\e[0m${time_status}"
    
    # Memory display
    local memory_color="\e[32m"  # Green by default
    local memory_status=""
    if [[ "$mle_status" == "true" ]]; then
      memory_color="\e[31m"  # Red for MLE
      memory_status=" \e[31m\e[1m(MLE)\e[0m"
    elif [[ -n "$memory_limit" ]]; then
      local memory_mb_actual
      memory_mb_actual=$(echo "scale=2; $memory_kb / 1024" | bc -l)
      local memory_percentage
      memory_percentage=$(echo "scale=1; $memory_mb_actual / $memory_limit * 100" | bc -l)
      if (( $(echo "$memory_percentage >= 80" | bc -l) )); then
        memory_color="\e[33m"  # Yellow for warning
      fi
      memory_status=" \e[90m(${memory_percentage}% of ${memory_limit}MB)\e[0m"
    fi
    
    echo -e "\e[1m│\e[0m \e[1mMemory:\e[0m    ${memory_color}\e[1m${formatted_memory}\e[0m${memory_status}"
    echo -e "\e[1m└───────────────────────────────────────────┘\e[0m"
  else
    echo
    echo "Performance Metrics:"
    echo "Runtime: $formatted_time"
    if [[ "$tle_status" == "true" ]]; then
      echo "         (TLE - Time Limit Exceeded)"
    fi
    echo "Memory:  $formatted_memory"
    if [[ "$mle_status" == "true" ]]; then
      echo "         (MLE - Memory Limit Exceeded)"
    fi
  fi
}

# Function to compile the source file
compile_file() {
  local compiler="$1"
  local source_file="$2"
  local output_file="$3"
  local extension="${source_file##*.}"
  local specific_flags=""

  # Use language-specific flags
  case "$extension" in
  c) specific_flags="$c_flags" ;;
  cpp | cc | cxx) specific_flags="$cpp_flags" ;;
  esac

  "$compiler" $compiler_flags $specific_flags -o "$output_file" "$source_file" $linker_flags
}

# Function to run the compiled program with performance measurement
run_program() {
  local output_file="$1"
  local input_file="$2"
  local program_output
  local runtime_ms=0
  local memory_kb=0
  local tle_status="false"
  local mle_status="false"
  local exit_code=0

  if [[ "$measure_performance" == "true" ]]; then
    # Create temporary files for time and memory measurement
    local time_file="/tmp/run-gcc-time-$$"
    local stdout_file="/tmp/run-gcc-stdout-$$"
    local perf_file="/tmp/run-gcc-perf-$$"
    
    # Use GNU time to measure performance
    local time_cmd="/usr/bin/time"
    local time_format="%e %M"  # elapsed time in seconds, maximum memory in KB
    
    if [[ -n "$execution_timeout" ]]; then
      if [[ -n "$input_file" ]]; then
        $time_cmd -f "$time_format" -o "$time_file" timeout "$execution_timeout" ./"$output_file" <"$input_file" > "$stdout_file" 2>&1 || exit_code=$?
      else
        $time_cmd -f "$time_format" -o "$time_file" timeout "$execution_timeout" ./"$output_file" > "$stdout_file" 2>&1 || exit_code=$?
      fi
    else
      if [[ -n "$input_file" ]]; then
        $time_cmd -f "$time_format" -o "$time_file" ./"$output_file" <"$input_file" > "$stdout_file" 2>&1 || exit_code=$?
      else
        $time_cmd -f "$time_format" -o "$time_file" ./"$output_file" > "$stdout_file" 2>&1 || exit_code=$?
      fi
    fi
    
    # Extract program output
    if [[ -f "$stdout_file" ]]; then
      program_output=$(cat "$stdout_file")
    fi
    
    # Parse timing information
    if [[ -f "$time_file" ]]; then
      local time_info
      time_info=$(cat "$time_file" 2>/dev/null || echo "0.000 0")
      local runtime_s memory_kb_raw
      read -r runtime_s memory_kb_raw <<< "$time_info"
      
      # Convert seconds to milliseconds
      runtime_ms=$(echo "$runtime_s * 1000" | bc -l 2>/dev/null || echo "0")
      memory_kb="$memory_kb_raw"
      
      # Check for TLE and MLE
      if [[ -n "$time_limit" ]] && (( $(echo "$runtime_s > $time_limit" | bc -l) )); then
        tle_status="true"
      fi
      
      if [[ -n "$memory_limit" ]]; then
        local memory_mb_actual
        memory_mb_actual=$(echo "scale=2; $memory_kb / 1024" | bc -l)
        if (( $(echo "$memory_mb_actual > $memory_limit" | bc -l) )); then
          mle_status="true"
        fi
      fi
    fi
    
    # Save performance data to file for later retrieval
    cat > "$perf_file" << EOF
PERF_RUNTIME_MS=$runtime_ms
PERF_MEMORY_KB=$memory_kb
PERF_TIME_LIMIT=$time_limit
PERF_MEMORY_LIMIT=$memory_limit
PERF_TLE_STATUS=$tle_status
PERF_MLE_STATUS=$mle_status
EOF
    
    # Clean up temporary files (but keep perf_file for main function)
    rm -f "$time_file" "$stdout_file"
    
    # Set exit code for TLE/MLE
    if [[ "$tle_status" == "true" || "$mle_status" == "true" ]]; then
      exit_code=1
    fi
  else
    # Original behavior without performance measurement
    if [[ -n "$execution_timeout" ]]; then
      if [[ -n "$input_file" ]]; then
        program_output=$(timeout "$execution_timeout" ./"$output_file" <"$input_file") || exit_code=$?
      else
        program_output=$(timeout "$execution_timeout" ./"$output_file") || exit_code=$?
      fi
    else
      if [[ -n "$input_file" ]]; then
        program_output=$(./"$output_file" <"$input_file") || exit_code=$?
      else
        program_output=$(./"$output_file") || exit_code=$?
      fi
    fi
  fi

  echo "$program_output"
  return $exit_code
}

# Function to compare output with expected output
compare_output() {
  local program_output="$1"
  local expected_file="$2"
  local show_diff="$3"
  local runtime_status="${4:-OK}"  # Default to OK if not provided
  
  # Check if there were performance issues first
  if [[ "$runtime_status" != "OK" ]]; then
    if [[ "$color_output" == "true" ]]; then
      case "$runtime_status" in
        "TLE")
          echo -e "\e[31m\e[1m[TLE]\e[0m Time Limit Exceeded \e[33m(skipped)\e[0m"
          ;;
        "MLE")
          echo -e "\e[31m\e[1m[MLE]\e[0m Memory Limit Exceeded \e[33m(skipped)\e[0m"
          ;;
        "TLE+MLE")
          echo -e "\e[31m\e[1m[TLE+MLE]\e[0m Limits Exceeded \e[33m(skipped)\e[0m"
          ;;
      esac
    else
      case "$runtime_status" in
        "TLE")
          echo "[TLE] Time Limit Exceeded (skipped)"
          ;;
        "MLE")
          echo "[MLE] Memory Limit Exceeded (skipped)"
          ;;
        "TLE+MLE")
          echo "[TLE+MLE] Limits Exceeded (skipped)"
          ;;
      esac
    fi
    return 1
  fi
  
  # Normal output comparison if no performance issues
  if diff <(echo "$program_output") "$expected_file" >/dev/null; then
    if [[ "$color_output" == "true" ]]; then
      echo -e "\e[32m\e[1m[PASS]\e[0m Output matches expected"
    else
      echo "[PASS] Output matches expected"
    fi
  else
    if [[ "$color_output" == "true" ]]; then
      echo -e "\e[31m\e[1m[FAIL]\e[0m Output mismatch"
    else
      echo "[FAIL] Output mismatch"
    fi
    if [[ "$show_diff" == "true" ]]; then
      echo
      echo "Difference:"
      diff <(echo "$program_output") "$expected_file" || true
    fi
    return 1
  fi
}

# Main function
main() {
  local input_file=""
  local expected_file=""
  local source_file=""
  local exit_code=0
  local generate_config_flag="false"
  local config_type="local"
  local new_file_flag="false"
  local new_filename=""
  local template_name=""
  local list_templates_flag="false"
  local list_extension=""
  
  # Track command line overrides
  local cmd_line_performance_set="false"
  local cmd_line_show_performance_set="false"
  local cmd_line_time_limit_set="false"
  local cmd_line_memory_limit_set="false"
  local cmd_line_show_diff_set="false"

  # Check if help, version, or special options are provided
  if [[ $# -ge 1 ]]; then
    case "$1" in
    -h | --help)
      show_help
      exit 0
      ;;
    -v | --version)
      show_version
      exit 0
      ;;
    --new)
      # Initialize template directory only when needed
      init_template_dir
      new_file_flag="true"
      shift
      if [[ $# -lt 1 ]]; then
        error_exit "Missing filename after '--new'"
      fi
      new_filename="$1"
      shift
      ;;
    --list-templates)
      # Initialize template directory only when needed
      init_template_dir
      list_templates_flag="true"
      shift
      if [[ $# -lt 1 ]]; then
        error_exit "Missing extension after '--list-templates'"
      fi
      list_extension="$1"
      shift
      # List templates and exit
      list_templates "$list_extension"
      exit 0
      ;;
    --generate-config)
      generate_config_flag="true"
      shift
      
      # Check for global/local flag
      if [[ $# -gt 0 ]]; then
        case "$1" in
        -g | --global)
          config_type="global"
          shift
          ;;
        --local)
          config_type="local"
          shift
          ;;
        -*)
          error_exit "Unknown option '$1' for --generate-config"
          ;;
        esac
      fi
      
      # If only generating config, do it and exit
      if [[ $# -eq 0 ]]; then
        generate_config "$config_type"
        exit 0
      fi
      ;;
    esac
  fi

  # If creating new file, handle template selection
  if [[ "$new_file_flag" == "true" ]]; then
    # Parse remaining arguments for --template flag
    while [[ $# -gt 0 ]]; do
      case "$1" in
      --template)
        if [[ $# -lt 2 ]]; then
          error_exit "Missing template name after '--template'"
        fi
        template_name="$2"
        shift 2
        ;;
      -*)
        error_exit "Unknown option '$1' for --new"
        ;;
      *)
        error_exit "Unexpected argument '$1'"
        ;;
      esac
    done
    
    # Use default template if not specified
    if [[ -z "$template_name" ]]; then
      template_name="$default_template"
    fi
    
    # Create file from template and exit
    create_from_template "$new_filename" "$template_name"
    exit 0
  fi

  # If we're not generating config or creating new file, ensure at least one argument is provided
  if [[ "$generate_config_flag" == "false" && $# -lt 1 ]]; then
    error_exit "Please specify a C/C++ file"
  fi

  # Extract the source file as the first argument (if not generating config only)
  if [[ "$generate_config_flag" == "false" ]]; then
    source_file="$1"
    shift
  fi

  # Parse remaining arguments
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -i | --input)
      if [[ $# -lt 2 ]]; then
        error_exit "Missing input file after '$1'"
      fi
      input_file="$2"
      shift 2
      ;;
    -e | --expected)
      if [[ $# -lt 2 ]]; then
        error_exit "Missing expected output file after '$1'"
      fi
      expected_file="$2"
      shift 2
      ;;
    -d | --diff)
      show_diff="true"
      cmd_line_show_diff_set="true"
      shift
      ;;
    -n | --no-config)
      skip_config="true"
      shift
      ;;
    -p | --performance)
      measure_performance="true"
      cmd_line_performance_set="true"
      shift
      ;;
    -t | --time-limit)
      if [[ $# -lt 2 ]]; then
        error_exit "Missing time limit after '$1'"
      fi
      time_limit="$2"
      measure_performance="true"
      cmd_line_time_limit_set="true"
      cmd_line_performance_set="true"
      shift 2
      ;;
    -m | --memory-limit)
      if [[ $# -lt 2 ]]; then
        error_exit "Missing memory limit after '$1'"
      fi
      memory_limit="$2"
      measure_performance="true"
      cmd_line_memory_limit_set="true"
      cmd_line_performance_set="true"
      shift 2
      ;;
    --no-performance)
      show_performance="false"
      cmd_line_show_performance_set="true"
      shift
      ;;
    -*)
      error_exit "Unknown option '$1'"
      ;;
    *)
      error_exit "Unexpected argument '$1'"
      ;;
    esac
  done

  # If we were generating config and got here, generate it now
  if [[ "$generate_config_flag" == "true" ]]; then
    generate_config "$config_type"
    exit 0
  fi

  # Store command line overrides before loading config
  local cmd_show_performance="$show_performance"
  local cmd_measure_performance="$measure_performance"
  local cmd_time_limit="$time_limit"
  local cmd_memory_limit="$memory_limit"
  local cmd_show_diff="$show_diff"

  # Load configuration files unless skipped
  if [[ "$skip_config" != "true" ]]; then
    load_config

    # Restore command line overrides after config loading
    if [[ "$cmd_line_show_performance_set" == "true" ]]; then
      show_performance="$cmd_show_performance"
    fi
    if [[ "$cmd_line_performance_set" == "true" ]]; then
      measure_performance="$cmd_measure_performance"
    fi
    if [[ "$cmd_line_time_limit_set" == "true" ]]; then
      time_limit="$cmd_time_limit"
    fi
    if [[ "$cmd_line_memory_limit_set" == "true" ]]; then
      memory_limit="$cmd_memory_limit"
    fi
    if [[ "$cmd_line_show_diff_set" == "true" ]]; then
      show_diff="$cmd_show_diff"
    fi

    # Override input file and expected file if not already set manually
    input_file="${input_file:-$default_input_file}"
    expected_file="${expected_file:-$default_expected_file}"
  fi

  local source_filename="${source_file##*/}"
  local output_file="${source_filename%.*}"

  # Check if the source file exists
  if [[ ! -f "$source_file" ]]; then
    error_exit "File '$source_file' does not exist"
  fi

  # Check if the input file exists (if provided)
  if [[ -n "$input_file" && ! -f "$input_file" ]]; then
    error_exit "Input file '$input_file' does not exist"
  fi

  # Check if the expected output file exists (if provided)
  if [[ -n "$expected_file" && ! -f "$expected_file" ]]; then
    error_exit "Expected output file '$expected_file' does not exist"
  fi

  # Determine the compiler
  local compiler
  compiler=$(get_compiler "$source_file")

  # Compile, run, and clean up
  compile_file "$compiler" "$source_file" "$output_file"
  local program_output
  local runtime_status="OK"
  program_output=$(run_program "$output_file" "$input_file") || exit_code=$?
  
  # Check for performance issues and set status
  local perf_file="/tmp/run-gcc-perf-$$"
  local tle_occurred="false"
  local mle_occurred="false"
  
  if [[ "$measure_performance" == "true" && -f "$perf_file" ]]; then
    # Read performance data from file
    source "$perf_file"
    tle_occurred="$PERF_TLE_STATUS"
    mle_occurred="$PERF_MLE_STATUS"
    
    # Set runtime status based on performance issues
    if [[ "$tle_occurred" == "true" && "$mle_occurred" == "true" ]]; then
      runtime_status="TLE+MLE"
    elif [[ "$tle_occurred" == "true" ]]; then
      runtime_status="TLE"
    elif [[ "$mle_occurred" == "true" ]]; then
      runtime_status="MLE"
    fi
  fi
  
  # Handle output comparison or display
  if [[ -n "$expected_file" ]]; then
    # Pass runtime status to compare_output for enhanced messaging
    compare_output "$program_output" "$expected_file" "$show_diff" "$runtime_status" || exit_code=$?
  else
    # Display program output
    echo "$program_output"
    
    # Show runtime status if there were performance issues
    if [[ "$runtime_status" != "OK" ]]; then
      if [[ "$color_output" == "true" ]]; then
        case "$runtime_status" in
          "TLE")
            echo -e "\e[31m\e[1m[TLE]\e[0m Time Limit Exceeded"
            ;;
          "MLE")
            echo -e "\e[31m\e[1m[MLE]\e[0m Memory Limit Exceeded"
            ;;
          "TLE+MLE")
            echo -e "\e[31m\e[1m[TLE+MLE]\e[0m Limits Exceeded"
            ;;
        esac
      else
        case "$runtime_status" in
          "TLE")
            echo "[TLE] Time Limit Exceeded"
            ;;
          "MLE")
            echo "[MLE] Memory Limit Exceeded"
            ;;
          "TLE+MLE")
            echo "[TLE+MLE] Limits Exceeded"
            ;;
        esac
      fi
    fi
  fi

  # Display performance metrics if they were collected
  if [[ "$measure_performance" == "true" && -f "$perf_file" ]]; then
    display_performance "$PERF_RUNTIME_MS" "$PERF_MEMORY_KB" "$PERF_TIME_LIMIT" "$PERF_MEMORY_LIMIT" "$PERF_TLE_STATUS" "$PERF_MLE_STATUS"
    rm -f "$perf_file"
  fi

  if [[ "$cleanup_output" == "true" ]]; then
    rm -f "$output_file"
  fi

  exit $exit_code
}

main "$@"
